
<#import "shared/layout.ftlh" as layout>

<@layout.layout>

<main class="error-page">

    <p class="eyebrow">404 | LOST IN SPACE</p>

    <h1>Character Not Found</h1>

    <p>
       Character could not be found!
    </p>

    <p>
        The character may have been removed,
        or the link may be incorrect.
    </p>

    <a href="/characters" class="details-button">
        Return to Gallery
    </a>

</main>

</@layout.layout>
